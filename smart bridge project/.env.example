# Food Verse AI - Multimodal Food Intelligence Agent
# Environment Configuration Template

# Server Configuration
PROJECT_NAME="Food Verse AI – Multimodal Food Intelligence Agent"
VERSION="1.0.0"
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite by default, or PostgreSQL)
# Example SQLite: sqlite:///./food_verse.db
# Example Postgres: postgresql://postgres:password@localhost:5432/food_verse_db
DATABASE_URL=sqlite:///./food_verse.db

# Multimodal AI Integration (Google Gemini API)
# Obtain an API key from https://aistudio.google.com/
# When left empty, the application automatically runs in local deterministic mode
# using OpenCV image processing and USDA nutritional databases.
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# Frontend API URL (Configured in frontend/.env)
VITE_API_BASE_URL=http://localhost:8000/api

